nts":[],"widgetType":"icon"}],"isInner":false,"styles":{"e-tuition-options-intro":{"id":"e-tuition-options-intro","label":"e-tuition-options-intro","type":"class","variants":[{"meta":{"breakpoint":"desktop","state":null},"props":{"width":{"$$type":"size","value":{"size":100,"unit":"%"}},"min-width":{"$$type":"size","value":{"size":0,"unit":"px"}},"text-align":{"$$type":"string","value":"center"},"display":{"$$type":"string","value":"flex"},"flex-direction":{"$$type":"string","value":"column"},"align-items":{"$$type":"string","value":"center"}},"custom_css":null}]}},"interactions":[],"editor_settings":[],"version":"0.0"},{"id":"12d12bb","elType":"e-flexbox","settings":{"classes":{"$$type":"classes","value":["e-tuition-options-list"]}},"elements":[{"id":"aee7d09","elType":"widget","settings":{"editor":"<ol>\n<li>\n<strong>Monthly Payment Plan:<\/strong> Students may pay for classes using installments automatically every month until all fees are paid in full in full before attending the first class. We know that no one wants the added burden of searching out all the payment options available and then weighing them against each other. That\u2019s why we are here to help. We make it easier for you to look at all the different payment options available and decide how to pay for your healthcare career training program.\n<\/li>\n<li>\n<strong>Full Tuition:<\/strong> Students may pay their tuition in full before attending the first class. This is an option for students who can afford it and want to pay their entire tuition at once.\n<\/li>\n<li>\n<strong>Pro-Rata Tuition:<\/strong> Students may pay their tuition on a pro-rata basis over the length of the program. All fees must have been met in full prior to graduation. This is an option for students who cannot afford to pay their entire tuition at once and would like to spread out payments over time.\n<\/li>\n<li>\n<strong>Federal Financial Aid:<\/strong> for those students who qualify.\n<ul>\n<li>\n<strong>Federal Pell Grant:<\/strong> This grant is awarded by the government to undergraduate students who demonstrate financial need and whose family income falls within specific limits set by law. Eligibility requirements include being a U.S citizen or eligible noncitizen, having demonstrated financial need, and meeting specific academic requirements. U.S. Department of Education\n<\/li>\n<li>\n<strong>Direct Loan:<\/strong> The Direct Loan Program is a loan program that provides financial aid directly to students enrolled at least half-time at an eligible school to help cover educational expenses such as tuition and fees not covered by other federal student aid programs (such as grants). What is a direct loan?\n<\/li>\n<\/ul>\n<\/li>\n<\/ol>","text_color":"#29435f","link_color":"#005fbd","link_hover_color":"#003f7d","typography_typography":"custom","typography_font_family":"Nunito","typography_font_weight":"500","typography_font_size":{"unit":"px","size":16,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":16,"sizes":[]},"typography_line_height":{"unit":"em","size":1.68,"sizes":[]},"_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[],"widgetType":"text-editor"}],"isInner":false,"styles":{"e-tuition-options-list":{"id":"e-tuition-options-list","label":"e-tuition-options-list","type":"class","variants":[{"meta":{"breakpoint":"desktop","state":null},"props":{"width":{"$$type":"size","value":{"size":100,"unit":"%"}},"min-width":{"$$type":"size","value":{"size":0,"unit":"px"}},"max-width":{"$$type":"size","value":{"size":1140,"unit":"px"}},"display":{"$$type":"string","value":"flex"},"flex-direction":{"$$type":"string","value":"column"},"align-self":{"$$type":"string","value":"center"}},"custom_css":null}]}},"interactions":[],"editor_settings":[],"version":"0.0"}],"isInner":false,"styles":{"e-tuition-options-inner":{"id":"e-tuition-options-inner","label":"e-tuition-options-inner","type":"class","variants":[{"meta":{"breakpoint":"des