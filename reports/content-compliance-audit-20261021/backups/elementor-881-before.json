string","value":"flex"},"flex-direction":{"$$type":"string","value":"column"},"gap":{"$$type":"size","value":{"size":13,"unit":"px"}},"align-items":{"$$type":"string","value":"center"},"align-self":{"$$type":"string","value":"center"}},"custom_css":null}]}},"interactions":[],"editor_settings":[],"version":"0.0"},{"id":"a65cf87","elType":"e-flexbox","settings":{"classes":{"$$type":"classes","value":["e-pta-criteria-list"]}},"elements":[{"id":"3d48339","elType":"widget","settings":{"editor":"<ol>\n \t<li>Applicant must submit a SABER college application, including a writing sample\n<\/li>\n \t<li>Applicants must submit a High School Diploma (or equivalent in their country of origin) or GED.\n<\/li>\n \t<li>Applicant must be 18 years of age or over\n<\/li>\n \t<li>Applicant must score at the 11.0 level in mathematics, language, and reading on the TABE Test. (Students with an AA or higher degree of education are exempt)\n<\/li>\n \t<li>Applicant must submit official school transcripts documenting any previous academic work, with a minimum GPA of 2.0 average or better on a 4.0 scale, from an educational institution accredited by an agency that is recognized by the US Department of Education. This will include applicants requesting credit for general education courses previously taken at the associate degree level or higher.\n<\/li>\n \t<li>Applicant must successfully complete a personal oral interview with the Program Director and or an administrative representative of the program to evaluate the applicant\u2019s ability to communicate satisfactorily as required by the health care delivery system.  The interviewer must recommend the applicant for admission.\n<\/li>\n \t<li> Applicant must submit three letters of recommendation from a Physical Therapist, Physical Therapist Assistant, previous instructor, or current\/past employer.  Letters must have the contact information of the person writing the recommendation, such as name, signature, phone number, and address.\n<\/li>\n \t<li>Perform a minimum of 20 observation hours in a Physical Therapy setting (signed by the supervising PT or PTA) and submit SABER College\u2019s Clinic Observation Form in a signed sealed envelope.\n<\/li>\n<li>\nOnce accepted into the program, the applicant must undergo a criminal background check and drug screen.\n<\/li>\n<li>\nMaximum enrollment for each cohort is capped at 24 students.\n<\/li>\n<\/ol>","text_color":"#29435f","link_color":"#005fbd","link_hover_color":"#003f7d","typography_typography":"custom","typography_font_family":"Nunito","typography_font_weight":"500","typography_font_size":{"unit":"px","size":16,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":16,"sizes":[]},"typography_line_height":{"unit":"em","size":1.68,"sizes":[]},"_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[],"widgetType":"text-editor"}],"isInner":false,"styles":{"e-pta-criteria-list":{"id":"e-pta-criteria-list","label":"e-pta-criteria-list","type":"class","variants":[{"meta":{"breakpoint":"desktop","state":null},"props":{"width":{"$$type":"size","value":{"size":100,"unit":"%"}},"min-width":{"$$type":"size","value":{"size":0,"unit":"px"}},"max-width":{"$$type":"size","value":{"size":1140,"unit":"px"}},"display":{"$$type":"string","value":"flex"},"flex-direction":{"$$type":"string","value":"column"},"align-self":{"$$type":"string","value":"center"}},"custom_css":null}]}},"interactions":[],"editor_settings":[],"version":"0.0"}],"isInner":false,"styles":{"e-pta-criteria-inner":{"id":"e-pta-criteria-inner","label":"e-pta-criteria-inner","type":"class","variants":[{"meta":{"breakpoint":"desktop","state":null},"props":{"width":{"$$type":"size","value":{"size":100,"unit":"%"}},"min-width":{"$$type":"size","value":{"size":0,"unit":"px"}},"max-width":{"$$type":"size","value":{"size":1200,"unit":"px"}},"padding":{"$$type":"dimensions","value":{"block-start":{"$$type":"size","value":{"size":76,"unit":"px"}},"inline-end":{"