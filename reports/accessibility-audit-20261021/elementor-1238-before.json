34ea3"},{"text":"Schedule a Private Tour: Experience our campus facilities and meet our dedicated staff in person.","_id":"6dab1ec"},{"text":"Start Your Journey: Submit your contact information to receive personalized guidance from our admissions team.","_id":"0e645d9"},{"text":"Financial Aid Available: Funding options are available for those who qualify—ask us how we can help make your education more affordable.","_id":"bd70e0b"}],"icon_self_vertical_align":"flex-start","icon_vertical_offset":{"unit":"px","size":5,"sizes":[]},"__globals__":{"icon_color":"globals/colors?id=primary","text_color":"globals/colors?id=primary"}},"elements":[],"widgetType":"icon-list"}],"isInner":false},{"id":"e6ac8d0","elType":"widget","settings":{"title":"Admissions & Registration:\n","typography_typography":"custom","typography_font_family":"Nunito","typography_font_weight":"800"},"elements":[],"widgetType":"heading"},{"id":"39bd51d","elType":"widget","settings":{"editor":"<strong>Healthcare Programs:</strong>","__globals__":{"text_color":"globals/colors?id=primary"}},"elements":[],"widgetType":"text-editor"},{"id":"d800045","elType":"container","settings":{"flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"063f555","elType":"widget","settings":{"editor":"<strong>Contact:</strong>","__globals__":{"text_color":"globals/colors?id=primary"},"typography_typography":"custom","typography_font_family":"Nunito","typography_font_weight":"400"},"elements":[],"widgetType":"text-editor"},{"id":"f96ae6c","elType":"widget","settings":{"icon_list":[{"text":"Senior Director of Admissions: Lucy Alvarez","selected_icon":{"value":"fas fa-angle-right","library":"fa-solid"},"_id":"084b1a8"},{"text":"Email: lalvarez@sabercollege.edu","selected_icon":{"value":"fas fa-angle-right","library":"fa-solid"},"_id":"b6c4323"},{"text":"Phone: (305) 443-7030","selected_icon":{"value":"fas fa-angle-right","library":"fa-solid"},"_id":"579a5d1"}],"icon_self_vertical_align":"flex-start","icon_vertical_offset":{"unit":"px","size":5,"sizes":[]},"__globals__":{"icon_color":"globals/colors?id=primary","text_color":"globals/colors?id=primary"}},"elements":[],"widgetType":"icon-list"}],"isInner":false},{"id":"43505b0","elType":"container","settings":{"flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[],"isInner":false},{"id":"8791e2c","elType":"widget","settings":{"editor":"At SABER College, communication is an essential part of the student experience. Whether you are exploring program options, seeking clarification about admissions requirements, or preparing to begin your academic journey, our team is committed to providing timely, accurate, and personalized support. We believe informed decisions begin with open access to information, clear guidance, and responsive communication at every stage of the enrollment process.\n\n","__globals__":{"text_color":"globals/colors?id=primary"}},"elements":[],"widgetType":"text-editor"},{"id":"f65e178","elType":"widget","settings":{"editor":"Our admissions and student services professionals are available to guide prospective students through program selection, application steps, and important institutional policies. From your first inquiry to final enrollment, we aim to ensure that every interaction reflects our commitment to professionalism, transparency, and student centered service. We encourage individuals and families to reach out with questions, request additional materials, or schedule a visit to better understand our academic environment and campus resources.","__globals__":{"text_color":"globals/colors?id=primary"}},"elements":[],"widgetType":"text-editor"},{"id":"0a2bbbd","elType":"widget","settings":{"editor":"SABER College welcomes communication from prospective students, current students, alumni, and community partners. Each inquiry is handled with care and confidentiality, and our team works collaboratively to connect you with the appropriate department or specialist. By maintaining clear lines of communication, we support informed decision making, promote academic success, and reinforce our mission to provide accessible, high quality education that prepares students for meaningful career opportunities.\n\n","__globals__":{"text_color":"globals/colors?id=primary"}},"elements":[],"widgetType":"text-editor"},{"id":"58ff18d","elType":"widget","settings":{"html":"<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3592.971124418496!2d-80.2613336!3d25.7715173!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88d9b77196748d19%3A0xe6efe316822e9680!2sSABER%20College!5e0!3m2!1sen!2sus!4v1790276577730!5m2!1sen!2sus\" width=\"600\" height=\"450\" style=\"border:0;\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"strict-origin-when-cross-origin\"></iframe>"},"elements":[],"widgetType":"html"}],"isInner":false,"styles":{"e-dd7518d-efb0e22":{"id":"e-dd7518d-efb0e22","label":"local","type":"class","variants":[{"meta":{"breakpoint":"desktop","state":null},"props":{"max-width":{"$$type":"size","value":{"size":900,"unit":"px"}},"flex-direction":{"$$type":"string","value":"column"},"gap":{"$$type":"size","value":{"size":12,"unit":"px"}}},"custom_css":null}]}},"interactions":[],"editor_settings":[],"version":"0.0"}],"isInner":false,"styles":{"e-3ddc392-8a8ba81":{"id":"e-3ddc392-8a8ba81","label":"local","type":"class","variants":[{"meta":{"breakpoint":"desktop","state":null},"props":{"flex-direction":{"$$type":"string","value":"column"},"align-items":{"$$type":"string","value":"center"}},"custom_css":null}]}},"interactions":[],"editor_settings":[],"version":"0.0"}]
