                },
                "elements": [
                    {
                        "id": "c78e913",
                        "elType": "widget",
                        "settings": {
                            "title": "Please follow the steps below to submit your Student Transcript Request.\n",
                            "header_size": "h1",
                            "typography_typography": "custom",
                            "typography_font_family": "Nunito",
                            "typography_font_weight": "800"
                        },
                        "elements": [],
                        "widgetType": "heading"
                    },
                    {
                        "id": "25b14b5",
                        "elType": "widget",
                        "settings": {
                            "editor": "<a href=\"/wp-content/uploads/2024/10/SABER-College-Transcript-Request-10-07-24-New-Logo.docx.pdf\" target=\"_blank\" rel=\"noopener\"><strong>Click the image to download the form</strong></a>",
                            "__globals__": {
                                "text_color": "globals/colors?id=primary"
                            }
                        },
                        "elements": [],
                        "widgetType": "text-editor"
                    },
                    {
                        "id": "2b9865a",
                        "elType": "widget",
                        "settings": {
                            "editor": "<ol>\n<li>\nTo initiate the process, simply make a payment by calling 305-443-9170 at the main office. (Please mention the reference “payment for a transcript request”). The fee is $10.00 per copy and $25.00 for out-of-state requests. We've made it as convenient as possible for you.\n</li>\n<li>\nDownload and complete the request form with your information and scan the form to the following email address:\n<ul>\n<li>\nregistrar@sabercollege.edu (All Programs)\n</li>\n<li>\nlinette@sabercollege.edu (All Nursing after Dec 2020)\n</li>\n<li>\ndestevez@sabercollege.edu (All Nursing before Dec 2020)\n</li>\n<li>\nlalvarez@sabercollege.edu  (All Nursing before Dec 2020)\n</li>\n<li>\nkarocha@sabercollege.edu (PTA Program)\n</li>\n</ul>\n</li>\n<li>\nDon’t forget to attach proof of payment.\n</li>\n</ol>",
                            "__globals__": {
                                "text_color": "globals/colors?id=primary"
                            }
                        },
                        "elements": [],
                        "widgetType": "text-editor"
                    },
                    {
                        "id": "db01cd8",
                        "elType": "widget",
                        "settings": {
                            "editor": "<em>Transcripts will be prepared for pickup every Friday afternoon before 2:00 PM. If the request is to be sent to other institutions, this will occur every Friday by the close of business.</em>",
                            "__globals__": {
                                "text_color": "globals/colors?id=primary"
                            }
                        },
                        "elements": [],
                        "widgetType": "text-editor"
                    },
                    {
                        "id": "abaad2b",
                        "elType": "widget",
                        "settings": {
                            "editor": "If you would like to learn more about SABER College, you are cordially invited to visit our campus in Miami, Florida.",
                            "__globals__": {
                                "text_color": "globals/colors?id=primary"
                            }
                        },
                        "elements": [],
                        "widgetType": "text-editor"
                    }
